{
  "rewrites": [
    {
      "source": "/api/vnpt-uat/(.*)",
      "destination": "/api/vnpt-proxy?t=uat&p=$1"
    },
    {
      "source": "/api/vnpt/(.*)",
      "destination": "/api/vnpt-proxy?t=prod&p=$1"
    },
    {
      "source": "/api/emrhub-prod/:match*",
      "destination": "https://api.emrhub.vn/:match*"
    },
    {
      "source": "/api/emrhub-sandbox/:match*",
      "destination": "https://api-sandbox.emrhub.vn/:match*"
    },
    {
      "source": "/api/users",
      "destination": "/api/users"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
